// Catalogue (Phase 2), users (Phase 3), authoring and inboxes (Phase 4),
// enrollments and progress (Phase 5).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  PDF
  TEXT
}

model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  headline    String
  description String
  position    Int
  courses     Course[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Course {
  id             String       @id @default(uuid(7)) @db.Uuid
  slug           String       @unique
  title          String
  subtitle       String
  description    String
  outcomes       String[]
  level          CourseLevel
  status         CourseStatus @default(DRAFT)
  // Owner; null for the seeded sample catalogue.
  instructorId   String?      @map("instructor_id") @db.Uuid
  instructor     User?        @relation("taught", fields: [instructorId], references: [id])
  // Name shown to learners ("Taught by"); defaults to the owner's name.
  instructorName String       @map("instructor_name")
  // Nullable until pricing is decided in the payments phase.
  priceCents     Int?         @map("price_cents")
  currency       String       @default("USD") @db.Char(3)
  // S3 key of the cover image, if uploaded.
  coverKey       String?      @map("cover_key")
  categoryId     String       @map("category_id") @db.Uuid
  category       Category     @relation(fields: [categoryId], references: [id])
  sections       Section[]
  enrollments    Enrollment[]
  submittedAt    DateTime?    @map("submitted_at")
  // Feedback from the last review, shown to the instructor.
  reviewNote     String?      @map("review_note")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
  @@index([instructorId])
  @@map("courses")
}

model Section {
  id       String   @id @default(uuid(7)) @db.Uuid
  courseId String   @map("course_id") @db.Uuid
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int
  lessons  Lesson[]

  @@unique([courseId, position])
  @@map("sections")
}

model Lesson {
  id              String           @id @default(uuid(7)) @db.Uuid
  sectionId       String           @map("section_id") @db.Uuid
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title           String
  type            LessonType
  position        Int
  durationSeconds Int              @default(0) @map("duration_seconds")
  isPreview       Boolean          @default(false) @map("is_preview")
  // S3 object key for video/PDF lessons (Phase 4).
  mediaKey        String?          @map("media_key")
  // Body for text lessons.
  body            String?
  progress        LessonProgress[]

  @@unique([sectionId, position])
  @@map("lessons")
}

// A person who has signed in at least once. Identity, passwords and roles live in Cognito;
// this row lets the database reference users (enrollments, progress, courses they teach).
model User {
  // Cognito `sub` claim.
  id           String   @id @db.Uuid
  email        String
  name         String
  lastSignInAt DateTime @map("last_sign_in_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  coursesTaught          Course[]                @relation("taught")
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  instructorApplications InstructorApplication[] @relation("applicant")
  reviewedApplications   InstructorApplication[] @relation("reviewer")

  @@index([email])
  @@map("users")
}

enum InquiryType {
  GENERAL
  SUPPORT
  PARTNERSHIP
  FEEDBACK
  OTHER
}

// Messages from the public contact form, read by admins.
model ContactMessage {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String
  email       String
  company     String?
  inquiryType InquiryType @map("inquiry_type")
  message     String
  handledAt   DateTime?   @map("handled_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([handledAt, createdAt])
  @@map("contact_messages")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Requests to teach on the platform. Approval adds the applicant to the Cognito
// "instructor" group.
model InstructorApplication {
  id                 String            @id @default(uuid(7)) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  user               User              @relation("applicant", fields: [userId], references: [id])
  fullName           String            @map("full_name")
  initiatedName      String?           @map("initiated_name")
  email              String
  nationality        String
  phoneNumber        String            @map("phone_number")
  linkedIn           String?           @map("linked_in")
  website            String?
  expertise          String
  experienceYears    Int               @map("experience_years")
  degree             String
  certifications     String?
  workExperience     String            @map("work_experience")
  teachingExperience String            @map("teaching_experience")
  languages          String
  motivation         String
  philosophy         String
  strengths          String
  status             ApplicationStatus @default(PENDING)
  reviewNote         String?           @map("review_note")
  reviewedById       String?           @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?             @relation("reviewer", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?         @map("reviewed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("instructor_applications")
}

// A learner's place in a course. Free during early access; payments come later.
model Enrollment {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String    @map("course_id") @db.Uuid
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt   DateTime  @default(now()) @map("enrolled_at")
  // Set when every lesson is complete.
  completedAt  DateTime? @map("completed_at")
  // Last time the learner opened or progressed in the course (for "continue" ordering).
  lastActiveAt DateTime  @default(now()) @map("last_active_at")

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  userId              String    @map("user_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String    @map("lesson_id") @db.Uuid
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Where to resume a video.
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  completedAt         DateTime? @map("completed_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}
