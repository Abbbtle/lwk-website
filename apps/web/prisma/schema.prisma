// Catalogue (Phase 2), users (Phase 3), authoring and inboxes (Phase 4),
// enrollments and progress (Phase 5), account security and audit log (Phase 7),
// free resources for Explore (Phase 8), help and support (Phase 9), AI usage (Phase 10).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  PDF
  TEXT
}

model Category {
  id          String     @id @default(uuid(7)) @db.Uuid
  slug        String     @unique
  name        String
  headline    String
  description String
  position    Int
  courses     Course[]
  resources   Resource[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("categories")
}

model Course {
  id             String       @id @default(uuid(7)) @db.Uuid
  slug           String       @unique
  title          String
  subtitle       String
  description    String
  outcomes       String[]
  level          CourseLevel
  status         CourseStatus @default(DRAFT)
  // Owner; null for the seeded sample catalogue.
  instructorId   String?      @map("instructor_id") @db.Uuid
  instructor     User?        @relation("taught", fields: [instructorId], references: [id])
  // Name shown to learners ("Taught by"); defaults to the owner's name.
  instructorName String       @map("instructor_name")
  // Nullable until pricing is decided in the payments phase.
  priceCents     Int?         @map("price_cents")
  currency       String       @default("USD") @db.Char(3)
  // S3 key of the cover image, if uploaded.
  coverKey       String?      @map("cover_key")
  // Free for everyone, also once paid plans exist; listed in Explore.
  isFree         Boolean      @default(false) @map("is_free")
  // Sample content for testing, removed in one step before launch.
  isSample       Boolean      @default(false) @map("is_sample")
  categoryId     String       @map("category_id") @db.Uuid
  category       Category     @relation(fields: [categoryId], references: [id])
  sections       Section[]
  enrollments    Enrollment[]
  submittedAt    DateTime?    @map("submitted_at")
  // Feedback from the last review, shown to the instructor.
  reviewNote     String?      @map("review_note")
  publishedAt    DateTime?    @map("published_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
  @@index([instructorId])
  @@index([isFree, status])
  @@map("courses")
}

model Section {
  id       String   @id @default(uuid(7)) @db.Uuid
  courseId String   @map("course_id") @db.Uuid
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int
  lessons  Lesson[]

  @@unique([courseId, position])
  @@map("sections")
}

model Lesson {
  id              String           @id @default(uuid(7)) @db.Uuid
  sectionId       String           @map("section_id") @db.Uuid
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title           String
  type            LessonType
  position        Int
  durationSeconds Int              @default(0) @map("duration_seconds")
  isPreview       Boolean          @default(false) @map("is_preview")
  // S3 object key for video/PDF lessons (Phase 4).
  mediaKey        String?          @map("media_key")
  // Body for text lessons.
  body            String?
  progress        LessonProgress[]

  @@unique([sectionId, position])
  @@map("lessons")
}

// A person who has signed in at least once. Identity, passwords and roles live in Cognito;
// this row lets the database reference users (enrollments, progress, courses they teach).
model User {
  // Cognito `sub` claim.
  id           String   @id @db.Uuid
  email        String
  name         String
  lastSignInAt DateTime @map("last_sign_in_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Cognito groups as last seen or set by an admin. Tokens issued before `rolesChangedAt`
  // carry outdated groups, so these roles apply to them instead (changes take effect at once).
  roles              String[]  @default([])
  rolesChangedAt     DateTime? @map("roles_changed_at")
  // Tokens issued before this moment are rejected (signed out everywhere, disabled, password
  // changed on another device).
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  // Authenticator-app two-step verification, mirrored from Cognito. Required for admin tools.
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  // Set while an admin has disabled the account (Cognito refuses sign-in too).
  disabledAt         DateTime? @map("disabled_at")
  // Getting-started checklists and tips the user chose to hide (e.g. "learner-start").
  dismissedTips      String[]  @default([]) @map("dismissed_tips")

  coursesTaught          Course[]                @relation("taught")
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  instructorApplications InstructorApplication[] @relation("applicant")
  reviewedApplications   InstructorApplication[] @relation("reviewer")
  auditEvents            AuditEvent[]            @relation("actor")
  resourcesCreated       Resource[]              @relation("resourceCreator")
  supportRequests        SupportTicket[]         @relation("requester")
  assignedTickets        SupportTicket[]         @relation("assignee")
  supportMessages        SupportMessage[]
  notifications          Notification[]
  helpFeedback           HelpFeedback[]
  aiUsage                AiUsage[]
  aiFeedback             AiFeedback[]

  @@index([email])
  @@map("users")
}

enum InquiryType {
  GENERAL
  SUPPORT
  PARTNERSHIP
  FEEDBACK
  OTHER
}

// Messages from the public contact form, read by admins.
model ContactMessage {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String
  email       String
  company     String?
  inquiryType InquiryType @map("inquiry_type")
  message     String
  handledAt   DateTime?   @map("handled_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([handledAt, createdAt])
  @@map("contact_messages")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Requests to teach on the platform. Approval adds the applicant to the Cognito
// "instructor" group.
model InstructorApplication {
  id                 String            @id @default(uuid(7)) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  user               User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  fullName           String            @map("full_name")
  initiatedName      String?           @map("initiated_name")
  email              String
  nationality        String
  phoneNumber        String            @map("phone_number")
  linkedIn           String?           @map("linked_in")
  website            String?
  expertise          String
  experienceYears    Int               @map("experience_years")
  degree             String
  certifications     String?
  workExperience     String            @map("work_experience")
  teachingExperience String            @map("teaching_experience")
  languages          String
  motivation         String
  philosophy         String
  strengths          String
  status             ApplicationStatus @default(PENDING)
  reviewNote         String?           @map("review_note")
  reviewedById       String?           @map("reviewed_by_id") @db.Uuid
  reviewedBy         User?             @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?         @map("reviewed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([userId])
  @@map("instructor_applications")
}

// A learner's place in a course. Free during early access; payments come later.
model Enrollment {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId     String    @map("course_id") @db.Uuid
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt   DateTime  @default(now()) @map("enrolled_at")
  // Set when every lesson is complete.
  completedAt  DateTime? @map("completed_at")
  // Last time the learner opened or progressed in the course (for "continue" ordering).
  lastActiveAt DateTime  @default(now()) @map("last_active_at")

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  userId              String    @map("user_id") @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId            String    @map("lesson_id") @db.Uuid
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // Where to resume a video.
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  completedAt         DateTime? @map("completed_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@id([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// Who did what to whom, for admins. Written by the service layer for security-relevant
// actions (role changes, account status, review decisions, deletions).
model AuditEvent {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)
  // Kept when the actor's account is deleted.
  actorName  String   @map("actor_name")
  // Dotted verb, e.g. "user.role.granted".
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  summary    String
  details    Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorId])
  @@map("audit_events")
}

// Fixed-window counters for rate limiting (per IP or per user and action).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limits")
}

enum ResourceType {
  VIDEO
  AUDIO
  ARTICLE
  PDF
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
}

// Free content in Explore (a single video, recording, article or PDF), open to everyone.
// Managed by admins.
model Resource {
  id              String         @id @default(uuid(7)) @db.Uuid
  slug            String         @unique
  title           String
  // One or two sentences for cards and search results.
  summary         String
  type            ResourceType
  // Article text (simple Markdown); for other types an optional description.
  body            String         @default("")
  // S3 key of the video, audio or PDF file.
  mediaKey        String?        @map("media_key")
  durationSeconds Int            @default(0) @map("duration_seconds")
  coverKey        String?        @map("cover_key")
  categoryId      String?        @map("category_id") @db.Uuid
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Name shown as the speaker or author.
  authorName      String         @map("author_name")
  createdById     String?        @map("created_by_id") @db.Uuid
  createdBy       User?          @relation("resourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  status          ResourceStatus @default(DRAFT)
  isSample        Boolean        @default(false) @map("is_sample")
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("resources")
}

enum TicketStatus {
  OPEN
  // Waiting for the person who asked.
  PENDING
  RESOLVED
  CLOSED
}

enum TicketCategory {
  ACCOUNT
  LEARNING
  TEACHING
  TECHNICAL
  FEEDBACK
  OTHER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A support request from a signed-in person, answered by admins and support staff in-app.
model SupportTicket {
  id             String           @id @default(uuid(7)) @db.Uuid
  // Short reference shown to people ("#1001").
  number         Int              @unique @default(autoincrement())
  requesterId    String           @map("requester_id") @db.Uuid
  requester      User             @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  subject        String
  category       TicketCategory
  status         TicketStatus     @default(OPEN)
  priority       TicketPriority   @default(NORMAL)
  // Where the person was when they asked, and their browser, for technical problems.
  pageUrl        String?          @map("page_url")
  userAgent      String?          @map("user_agent")
  assigneeId     String?          @map("assignee_id") @db.Uuid
  assignee       User?            @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages       SupportMessage[]
  lastActivityAt DateTime         @default(now()) @map("last_activity_at")
  resolvedAt     DateTime?        @map("resolved_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([status, lastActivityAt])
  @@index([requesterId, lastActivityAt])
  @@index([assigneeId])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(uuid(7)) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String?       @map("author_id") @db.Uuid
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Kept if the author's account is deleted.
  authorName String        @map("author_name")
  fromStaff  Boolean       @map("from_staff")
  // Internal notes are only shown to staff.
  internal   Boolean       @default(false)
  body       String
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// In-app notifications (the bell). Email follows once outgoing email is set up.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Dotted kind, e.g. "support.reply", for icons and later email preferences.
  kind      String
  title     String
  body      String?
  href      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// "Was this article helpful?" answers, to improve the help centre.
model HelpFeedback {
  id          String   @id @default(uuid(7)) @db.Uuid
  articleSlug String   @map("article_slug")
  helpful     Boolean
  comment     String?
  userId      String?  @map("user_id") @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([articleSlug, createdAt])
  @@map("help_feedback")
}

// One call to an AI model: what it cost, for the monthly spending cap and the admin report.
// Conversations themselves are not stored.
model AiUsage {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // What it was for, e.g. "assistant", "lesson-helper", "course-outline".
  feature          String
  model            String
  inputTokens      Int      @default(0) @map("input_tokens")
  outputTokens     Int      @default(0) @map("output_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  // Estimated cost in millionths of a US dollar.
  costMicros       Int      @default(0) @map("cost_micros")
  // "ok", "error", "limited" (rate limit or budget) or "unavailable".
  outcome          String
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage")
}

// A thumbs up or down on an assistant answer, kept with the question and answer so staff can
// improve the help content. Only stored when someone chooses to rate an answer.
model AiFeedback {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  feature   String
  helpful   Boolean
  question  String
  answer    String
  path      String?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("ai_feedback")
}
