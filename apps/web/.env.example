# Copy to .env.local and fill in. Never commit real values.
# Local Postgres (Postgres.app, database lwk_dev)
DATABASE_URL=postgresql://lwk:CHANGE_ME@localhost:5432/lwk_dev
# Separate database used by the automated tests (npm test)
TEST_DATABASE_URL=postgresql://lwk:CHANGE_ME@localhost:5432/lwk_test
# Public URL of this app (used for sign-in redirects)
APP_URL=http://localhost:3000
# Cognito (outputs of the lwk-dev-auth stack; public identifiers, not secrets)
COGNITO_USER_POOL_ID=af-south-1_vNL5Ybi4T
COGNITO_CLIENT_ID=2h3omuejks8avr9gjpdm9q3d9b
COGNITO_DOMAIN=https://livingwithkrishna-dev.auth.af-south-1.amazoncognito.com
# Local AWS access for server-side calls (Cognito groups, S3 uploads): `aws login --profile lwk`.
# Not set in AWS, where the instance role provides credentials.
AWS_PROFILE=lwk
